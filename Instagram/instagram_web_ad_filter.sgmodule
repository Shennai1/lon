#!name=Instagram Web Ad Filter - Verification
#!desc=Hybrid safe mode: preserves Instagram JSON, dynamically collapses about 4/5 of exact-match ads, and keeps a geometry-safe overlay for about 1/5. Includes a v1.3.4 rollback path.
# Author: Shennai1
# Homepage: https://github.com/Shennai1/lon/tree/main/Instagram
# Date: 2026-08-06
# Version: 1.3.5

[Script]
ig_web_ad_observer_v135 = type=http-response, pattern=^https://(www\.|i\.)?instagram\.com/(api/graphql/?|graphql/query/?|api/v1/(feed/(timeline|reels_media)/?|discover/[^?]*|clips/[^?]*|stories/reel/media/?)), requires-body=true, max-size=5242880, timeout=10, debug=true, script-update-interval=86400, script-path=https://raw.githubusercontent.com/Shennai1/lon/26bb8b2e6054fee6fa47703ee6898f31583a69af/Instagram/ig_ad_filter.js
ig_web_hybrid_filter_v135 = type=http-response, pattern=^https://www\.instagram\.com/(?:$|\?(?:[^#]*&)?__pwa=1(?:&|$)), requires-body=true, max-size=5242880, timeout=10, debug=true, script-update-interval=86400, script-path=https://raw.githubusercontent.com/Shennai1/lon/26bb8b2e6054fee6fa47703ee6898f31583a69af/Instagram/ig_ad_filter.js

[MITM]
hostname = %APPEND% instagram.com, www.instagram.com, i.instagram.com
