#!name=Instagram Web Ad Filter - Verification
#!desc=Filters high-confidence ad objects from Instagram Web JSON responses and adds an X-Surge-IG-Ad-Filter diagnostic header.
# Author: Shennai1
# Homepage: https://github.com/Shennai1/lon/tree/main/Instagram
# Date: 2026-08-05
# Version: 1.1.0

[Script]
ig_web_ad_filter = type=http-response, pattern=^https://(www\.|i\.)?instagram\.com/(api/graphql/?|graphql/query/?|api/v1/(feed/(timeline|reels_media)/?|discover/[^?]*|clips/[^?]*|stories/reel/media/?)), requires-body=true, max-size=5242880, timeout=10, debug=true, script-update-interval=86400, script-path=https://raw.githubusercontent.com/Shennai1/lon/main/Instagram/ig_ad_filter.js

[URL Rewrite]
^https://(www\.|i\.)?instagram\.com/api/v1/injected_story_units/ _ reject

[MITM]
hostname = %APPEND% instagram.com, www.instagram.com, i.instagram.com
