#!name=Instagram Web Ad Filter - Verification
#!desc=Hardened compact mode: keeps Instagram JSON intact, retains ad article nodes at 120px, and covers more safe homepage and Meta ad-redirect variants. Includes tested rollback modules.
#!category=Ads
#!raw-url=https://raw.githubusercontent.com/Shennai1/lon/main/Instagram/instagram_web_ad_filter.sgmodule
# Author: Shennai1
# Homepage: https://github.com/Shennai1/lon/tree/main/Instagram
# Date: 2026-08-06
# Version: 1.3.8

[Script]
ig_web_ad_observer_v138 = type=http-response, pattern=^https://(www\.|i\.)?instagram\.com/(api/graphql/?|graphql/query/?|graphql_www/?|api/v1/(feed/[^?]*|discover/[^?]*|clips/[^?]*|stories/reel/media/?)), requires-body=true, max-size=5242880, timeout=10, debug=true, script-update-interval=86400, script-path=https://raw.githubusercontent.com/Shennai1/lon/fc1465dcf41bd18a4a129f79b2f8cb479a88aeaf/Instagram/ig_ad_filter.js
ig_web_compact_filter_v138 = type=http-response, pattern=^https://www\.instagram\.com/(?:\?[^#]*)?$, requires-body=true, max-size=5242880, timeout=10, debug=true, script-update-interval=86400, script-path=https://raw.githubusercontent.com/Shennai1/lon/fc1465dcf41bd18a4a129f79b2f8cb479a88aeaf/Instagram/ig_ad_filter.js

[MITM]
hostname = %APPEND% instagram.com, www.instagram.com, i.instagram.com
