#!name=Instagram Web Ad Filter - Verification
#!desc=Compact 120px test: preserves Instagram JSON and ad article nodes, but reduces every exact-match ad to a small placeholder. Includes v1.3.6 and v1.3.4 rollback paths.
# Author: Shennai1
# Homepage: https://github.com/Shennai1/lon/tree/main/Instagram
# Date: 2026-08-06
# Version: 1.3.7

[Script]
ig_web_ad_observer_v137 = type=http-response, pattern=^https://(www\.|i\.)?instagram\.com/(api/graphql/?|graphql/query/?|api/v1/(feed/(timeline|reels_media)/?|discover/[^?]*|clips/[^?]*|stories/reel/media/?)), requires-body=true, max-size=5242880, timeout=10, debug=true, script-update-interval=86400, script-path=https://raw.githubusercontent.com/Shennai1/lon/41823aa0591521d547b1dd31c792353369e0ac43/Instagram/ig_ad_filter.js
ig_web_compact_filter_v137 = type=http-response, pattern=^https://www\.instagram\.com/(?:$|\?(?:[^#]*&)?__pwa=1(?:&|$)), requires-body=true, max-size=5242880, timeout=10, debug=true, script-update-interval=86400, script-path=https://raw.githubusercontent.com/Shennai1/lon/41823aa0591521d547b1dd31c792353369e0ac43/Instagram/ig_ad_filter.js

[MITM]
hostname = %APPEND% instagram.com, www.instagram.com, i.instagram.com
